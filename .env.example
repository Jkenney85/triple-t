# Public URL people use to reach the app (https enables Secure cookies).
PUBLIC_URL=https://ttt.jamesdkenney.com

# Long random string used to sign session cookies. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=

# First admin account. Only used when the database has no users yet;
# changing these later does NOT change the existing admin's password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Time zone for "today" highlighting (IANA name).
TZ=America/Chicago
